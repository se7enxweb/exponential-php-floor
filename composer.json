{
    "name": "se7enxweb/exponential-php-floor",
    "description": "Lets Exponential 6.0.15 and later install on every PHP version it supports (7.4 to 8.5): each version of this metapackage belongs to one PHP range and requires the extension releases and libraries that run there, so Composer chooses the right set by itself.",
    "type": "metapackage",
    "keywords": [
        "exponential",
        "php",
        "metapackage",
        "php74",
        "compatibility"
    ],
    "homepage": "https://github.com/se7enxweb/exponential-php-floor",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0 <8.1",
        "se7enxweb/bccie": "~1.1.20",
        "se7enxweb/cjw_newsletter": "~4.2.16",
        "se7enxweb/cjw_themes_jumper": "~0.1.9",
        "se7enxweb/cjw_tmv": "~0.1.4",
        "se7enxweb/exp_adminui": "~1.0.0.50",
        "se7enxweb/exp_enhanced_link": "~1.0.9",
        "se7enxweb/expai": "~0.0.1.18",
        "se7enxweb/expchangeclass": "~1.0.11",
        "se7enxweb/exponential-velocity": "~0.0.4.55",
        "se7enxweb/expqueue": "~0.1.6",
        "se7enxweb/ezodf": "~7.0.0",
        "se7enxweb/ezownerchange": "~1.4.4",
        "se7enxweb/eztags": "~2.4.24",
        "se7enxweb/git_manager": "~2.0.24",
        "se7enxweb/sevenx_authentication_2fa": "~1.0.15",
        "se7enxweb/sevenx_dse": "~1.1.16",
        "se7enxweb/sqliimport": "~2.0.0",
        "se7enxweb/syndication": "~1.3.12",
        "se7enxweb/xrowextract": "~2.5.21",
        "google/recaptcha": "~1.3.1"
    }
}
